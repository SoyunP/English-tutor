# English Lab — Environment Variables
# Copy to .env.local and fill in values for Supabase mode.
# If these are missing, the app runs in DEMO mode with seeded local data.

# Supabase (optional — leave empty for demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo mode is auto-enabled when Supabase URL/keys are missing.
# DEMO mode uses a server-side JSON file store under .demo-data/
# It is NOT secure immutable storage for production grades.
NEXT_PUBLIC_FORCE_DEMO=false

# Default demo accounts (demo mode only)
DEMO_STUDENT_EMAIL=student@englishlab.local
DEMO_TEACHER_EMAIL=teacher@englishlab.local
DEMO_PASSWORD=demo1234
